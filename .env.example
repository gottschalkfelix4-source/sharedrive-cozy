# ---------------------------------------------------------------------------
# sharedrive - Konfiguration
# Kopiere diese Datei nach .env  (cp .env.example .env)  und passe sie an.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Wurzelverzeichnis fuer verschluesselte Chunks und die SQLite-Datenbank.
DATA_DIR=./data

# Oeffentliche Basis-URL. Wird fuer Share-Links und QR-Codes benutzt.
# Leer lassen = wird aus dem eingehenden Request abgeleitet.
PUBLIC_URL=

# Hinter einem Reverse Proxy (SWAG, Nginx Proxy Manager, Cloudflare Tunnel)
# auf 1 setzen. Dann werden X-Forwarded-For / X-Forwarded-Proto beachtet
# und Cookies als Secure markiert.
TRUST_PROXY=0

# --- HTTPS -----------------------------------------------------------------
# WICHTIG: Browser stellen die Verschluesselungs-API (crypto.subtle) nur in
# sicheren Kontexten bereit - also unter https:// sowie auf localhost/127.0.0.1.
# Fuer den Zugriff ueber eine LAN-IP wie http://192.168.1.10:3000 gibt es sie
# NICHT, und ohne sie kann sharedrive nicht arbeiten. Drei Wege:
#
#   1. Cloudflare Tunnel (kein Port oeffnen, Zertifikat inklusive)
#   2. Reverse Proxy mit Let's Encrypt (SWAG, Nginx Proxy Manager)
#   3. Direktes HTTPS im Prozess - dazu TLS_CERT und TLS_KEY setzen
#
# Pfade absolut oder relativ zum Projektordner.
TLS_CERT=
TLS_KEY=
# Nur noetig, wenn die Zertifikatskette eine eigene CA mitbringt.
TLS_CA=

# --- Sitzungen ------------------------------------------------------------
# Normalerweise leer lassen. Das Secret fuer die Admin-Sitzung wird beim ersten
# Start automatisch erzeugt und in DATA_DIR/session.secret abgelegt. Ein eigenes
# Secret ist nur noetig, um alle laufenden Anmeldungen sofort ungueltig zu machen.
# SESSION_SECRET=

# --- Admin ----------------------------------------------------------------
# Passwort fuer das Dashboard (/admin). Beim ersten Start unbedingt setzen.
# Wird nur als scrypt-Hash im Speicher gehalten.
ADMIN_PASSWORD=bitte-aendern

# Optional: Name der im Dashboard angezeigten Instanz.
INSTANCE_NAME=sharedrive

# --- Limits ---------------------------------------------------------------
# Maximale Groesse eines kompletten Transfers in Bytes (Standard 20 GiB).
MAX_TRANSFER_BYTES=21474836480
# Maximaler Speicherverbrauch aller Transfers zusammen in Bytes (0 = unbegrenzt).
STORAGE_QUOTA_BYTES=0
# Standard- und Maximal-Ablaufzeit in Stunden (Standard-Max = 30 Tage).
DEFAULT_EXPIRY_HOURS=168
MAX_EXPIRY_HOURS=720
# Wie oft ein Transfer standardmaessig heruntergeladen werden darf (0 = unbegrenzt).
DEFAULT_MAX_DOWNLOADS=0
# Aufbewahrung des Download-Logs in Tagen (DSGVO: so kurz wie moeglich).
DOWNLOAD_LOG_RETENTION_DAYS=30

# --- Benachrichtigungen ---------------------------------------------------
# Leer lassen = deaktiviert. Typ: json | ntfy | discord | smtp
NOTIFY_TYPE=
# Ziel-URL (Webhook/ntfy-Topic/Discord-Webhook) - nicht fuer Typ "smtp".
NOTIFY_URL=
# Empfaenger fuer den Benachrichtigungs-Typ "smtp".
NOTIFY_EMAIL_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sharedrive@example.com
SMTP_SECURE=starttls

# --- Branding (kann auch im Admin-Dashboard gesetzt werden) ---------------
BRAND_NAME=sharedrive
BRAND_TAGLINE=Dateien teilen, die nur ihr sehen koennt.
BRAND_THEME=sunset
BRAND_LOGO_URL=
